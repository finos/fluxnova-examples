      "id": 10,
      "options": {
        "bpmnUrl": "/public/plugins/fluxnova-bpmn-heatmap-panel/bpmn/loan-approval.bpmn",
        "bpmnXml": "",
        "metricField": "activity_id",
        "valueField": "Value",
        "showLabels": true,
        "thresholds": [
          {
            "min": 20,
            "max": 999999,
            "color": "#ad1457",
            "overlayColor": "rgba(173, 20, 87, 0.30)",
            "label": "critical",
            "description": "20+ tokens (critical)"
          },
          {
            "min": 10,
            "max": 19,
            "color": "#c62828",
            "overlayColor": "rgba(198, 40, 40, 0.25)",
            "label": "high",
            "description": "10\u201319 tokens (bottleneck)"
          },
          {
            "min": 3,
            "max": 9,
            "color": "#e65100",
            "overlayColor": "rgba(230, 81, 0, 0.20)",
            "label": "medium",
            "description": "3\u20139 tokens (building up)"
          },
          {
            "min": 1,
            "max": 2,
            "color": "#2e7d32",
            "overlayColor": "rgba(46, 125, 50, 0.15)",
            "label": "low",
            "description": "1\u20132 tokens (flowing)"
          }
        ]
      },
      "title": "\ud83d\udd25 BPMN Process Diagram \u2014 Live Token Heatmap",
      "description": "Visual BPMN diagram showing real-time token positions. Colour-coded badges indicate where tokens are accumulating (choke points). Pulls live data from Prometheus every 10s.",
      "type": "fluxnova-bpmn-heatmap-panel",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "fluxnova_activity_tokens{process=\"loan-approval-process\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "title": "\ud83d\udd25 Token Distribution by Activity (Bar Chart)",
      "description": "Shows where tokens are concentrated. Red = bottleneck. The wider the bar, the more tokens are stuck there.",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Tokens at Activity",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "scheme"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sort_desc(fluxnova_activity_tokens{activity_type=~\"userTask|serviceTask\"})",
          "legendFormat": "{{ activity_name }}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "\u23f1\ufe0f Oldest Token Age per Activity",
      "description": "How long the oldest token has been waiting at each task. Red indicates stuck tokens \u2014 key choke points.",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Age (seconds)",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "scheme"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "orange",
                "value": 14400
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100
      },
      "targets": [
        {
          "expr": "sort_desc(fluxnova_activity_oldest_token_age_seconds{activity_type=~\"userTask|serviceTask\"})",
          "legendFormat": "{{ activity_name }}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "\ud83d\udcca Token Ratio (% of total at each activity)",
      "description": "Percentage of all active tokens at each activity. Above 50% triggers the bottleneck alert.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "displayMode": "gradient",
        "orientation": "horizontal",
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizWidth": 50,
        "minVizHeight": 30
      },
      "targets": [
        {
          "expr": "sort_desc(fluxnova_activity_token_ratio{activity_type=\"userTask\"})",
          "legendFormat": "{{ activity_name }}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "\ud83d\udcc8 Token Count Over Time by Activity",
