# Do not write registry-specific "resolved" URLs into package-lock.json.
# The lock file is not committed (see .gitignore), but this keeps any lock
# a contributor generates locally registry-agnostic — so it never captures
# a private/mirror registry URL if it is ever shared or pasted. See:
# https://docs.npmjs.com/cli/using-npm/config#omit-lockfile-registry-resolved
omit-lockfile-registry-resolved=true
